# Copy to .env (./init.sh does it and fills the generated values). Never commit .env or secrets/.

# Public hostnames; DNS A records point at this host. stag0 used bitkit., mempool.bitkit. and electrs.bitkit.
STAGING_HOST=bitkit.staging.example.com
MEMPOOL_HOST=mempool.bitkit.staging.example.com
ELECTRUM_HOST=electrs.bitkit.staging.example.com
ACME_EMAIL=devops@example.com
# Local test only: CADDY_GLOBAL_OPTIONS=local_certs (Caddy's own CA instead of Let's Encrypt)
CADDY_GLOBAL_OPTIONS=

# BTC fiat rates source (stag0 served the production feed's data)
FX_UPSTREAM_ORIGIN=https://api1.blocktank.to
FX_UPSTREAM_PATH=/api/fx/rates/btc

# lnurl-auth-server source (private synonymdev/lnurl-auth-server), cloned beside bitkit-docker by default
LNURL_AUTH_SERVER_SRC=../../lnurl-auth-server

# Faucet: HTTP basic auth for deposit and mine (user:password); init.sh generates one. Empty leaves them open.
FAUCET_AUTH=
# Faucet limits and wallet
FAUCET_WALLET=faucet
FAUCET_DEFAULT_SAT=100000
FAUCET_MAX_SAT=10000000
FAUCET_MAX_BLOCKS=100

# Generated by ./init.sh
BITCOIN_RPC_USER=staging
BITCOIN_RPC_PASSWORD=
VSS_DB_PASSWORD=
MEMPOOL_DB_PASSWORD=
MEMPOOL_DB_ROOT_PASSWORD=
LDK_BACKUP_SECRET_KEY=
LDK_BACKUP_PUBLIC_KEY=
